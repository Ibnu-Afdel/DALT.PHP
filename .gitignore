# Dependencies
/node_modules
/.dalt/node_modules
/vendor

# Environment variables
.env

# IDE files
/.idea
/.vscode

# OS files
.DS_Store
Thumbs.db

/public/css/*
!/public/css/.gitkeep
/public/js/*
!/public/js/.gitkeep

# Logs
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/examples/
*.log

# Temporary files
*.tmp
*.temp

# Challenge runtime state (from php artisan challenge:start)
.dalt/active_challenge.txt
.dalt/challenge-backup/
.dalt/challenge-state.json
.dalt/challenge.lock
.dalt/progress.lock
.dalt/progress.json
.dalt/baseline/
.dalt-removing-*/
.git-removing-*/
/storage/framework/platform-removal.lock
/storage/framework/examples/.auth.json.detaching-*

# Database files
/database/*.sqlite
/database/*.db
!/database/.gitkeep
!/database/migrations/

/docs/CODE_REVIEW_WALKTHROUGH.md
/docs/NEW_CODE_REVIEW.md
/docs/

# Local agent-notes pointer file — not meant for other contributors, see AGENTS.md itself
/AGENTS.md
