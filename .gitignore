# Dependencies
/node_modules
/vendor

# Course labs are installed to be run, in place or in a temp copy. The anchored rule
# above does not reach them, so an installed lab would commit its whole dependency tree.
node_modules/

# Environment variables
.env

# IDE files
/.idea
/.vscode

# OS files
.DS_Store
Thumbs.db

/public/css/*
!/public/css/.gitkeep
/public/js/*
!/public/js/.gitkeep

# Logs
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/examples/
*.log

# Temporary files
*.tmp
*.temp

# Temporary removal workspaces
.dalt-removing-*/
.git-removing-*/
.dalt/workspace/
/storage/framework/platform-removal.lock
/storage/framework/examples/.auth.json.detaching-*

# Database files
/database/*.sqlite
/database/*.db
!/database/.gitkeep
!/database/migrations/

/docs/CODE_REVIEW_WALKTHROUGH.md
/docs/NEW_CODE_REVIEW.md
/docs/

# Local agent-notes pointer files — not meant for other contributors, see AGENTS.md itself.
# CLAUDE.md is a one-line redirect to AGENTS.md so Claude Code and Codex load the same rules.
/AGENTS.md
/CLAUDE.md
