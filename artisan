#!/usr/bin/env php
<?php

declare(strict_types=1);

$arguments = $argv;

function boot_core(): void
{
    if (!defined('BASE_PATH')) {
        define('BASE_PATH', __DIR__ . '/');
    }

    require_once BASE_PATH . 'vendor/autoload.php';
    require_once BASE_PATH . 'framework/Core/functions.php';
}

/** @return array{database: array<string, mixed>} */
function load_database_config(): array
{
    boot_core();

    $dotenv = Dotenv\Dotenv::createImmutable(base_path(''));
    if (method_exists($dotenv, 'safeLoad')) {
        $dotenv->safeLoad();
    } else {
        try {
            $dotenv->load();
        } catch (Dotenv\Exception\InvalidPathException) {
            // A missing .env is valid; config files provide their own defaults.
        }
    }

    $config = require base_path('config/database.php');
    if (!is_array($config) || !isset($config['database']) || !is_array($config['database'])) {
        throw new RuntimeException('config/database.php must return a database configuration array.');
    }

    return $config;
}

/** @param list<string> $command */
function run_foreground(array $command, ?string $workingDirectory = null): int
{
    $process = proc_open(
        $command,
        [STDIN, STDOUT, STDERR],
        $pipes,
        $workingDirectory,
        null,
        ['bypass_shell' => true],
    );

    if (!is_resource($process)) {
        fwrite(STDERR, "Unable to start command: {$command[0]}\n");

        return 1;
    }

    $exitCode = proc_close($process);

    return $exitCode === -1 ? 1 : $exitCode;
}

function platform_installed(): bool
{
    try {
        return Core\Platform::discover(base_path())->isInstalled();
    } catch (RuntimeException $exception) {
        fwrite(STDERR, $exception->getMessage() . "\n");
        exit(1);
    }
}

function require_platform(string $commandName): void
{
    if (platform_installed()) {
        require_once base_path('.dalt/bootstrap.php');

        return;
    }

    echo "\nGuided learning is not installed (.dalt directory is missing).\n";
    echo "Command '{$commandName}' is only available when guided learning is present.\n";
    echo "This project is running as the framework core only.\n\n";
    exit(1);
}

if (count($arguments) < 2 || $arguments[1] === 'help' || $arguments[1] === '--help' || $arguments[1] === '-h') {
    echo "\n";
    echo "╔══════════════════════════════════════════════════════════════╗\n";
    echo "║                    DALT.PHP Artisan CLI                      ║\n";
    echo "╚══════════════════════════════════════════════════════════════╝\n";
    echo "\n";
    echo "Usage: php artisan <command> [options]\n";
    echo "\n";
    echo "Available Commands:\n";
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
    echo "\n";
    
    echo "  dalt:test [challenge]   Run the test suite globally or for a specific challenge\n";
    echo "                          Example: php artisan dalt:test broken-auth\n";
    echo "\n";
    echo "  fullstack:status        What is actually built in the Fullstack track, and\n";
    echo "                          what is next. Computed from disk, never stale.\n";
    echo "\nDevelopment:\n";
    echo "  serve [host] [port]     Start PHP development server\n";
    echo "                          Example: php artisan serve\n";
    echo "                          Example: php artisan serve 0.0.0.0 8080\n";
    echo "\n";
    echo "  dev                     Start both PHP and Vite dev servers\n";
    echo "                          (Runs in background, use Ctrl+C to stop)\n";
    echo "\n";
    echo "Database:\n";
    echo "  migrate                 Run pending database migrations\n";
    echo "                          Executes .sql files from database/migrations/\n";
    echo "\n";
    echo "  migrate:fresh [--force] Drop database and run all migrations\n";
    echo "                          Requires confirmation; --force skips the prompt\n";
    echo "\n";
    echo "  make:migration <name>   Create a new SQL migration file\n";
    echo "                          Example: php artisan make:migration create_posts_table\n";
    echo "\n";
    echo "Testing:\n";
    echo "  test                    Run Pest test suite\n";
    echo "                          Executes all tests in tests/ directory\n";
    echo "\n";
    echo "  verify <challenge>      Verify a challenge (legacy, specify by name)\n";
    echo "\nChallenges (use challenge:* for the full workflow):\n";
    echo "  challenge:list          List all available challenges\n";
    echo "  challenge:start <name> [--force]\n";
    echo "                          Load broken files for a challenge into your app\n";
    echo "                          Requires confirmation; --force skips the prompt\n";
    echo "  challenge:verify        Verify your fix (checks active challenge)\n";
    echo "  challenge:reset         Reset to buggy baseline (fresh start)\n";
    echo "  challenge:stop          Stop challenge and restore clean app\n";
    echo "\nGuided learning:\n";
    echo "  platform:status         Show whether guided learning is installed (.dalt)\n";
    echo "  platform:clean [--force] Remove guided learning (framework core only)\n";
    echo "  platform:remove [--force] Alias of platform:clean\n";
    echo "                          WARNING: This removes .dalt/ permanently!\n";
    echo "\nExamples:\n";
    echo "  example:install auth    Install authentication example safely\n";
    echo "  example:update auth     Update untouched generated auth files\n";
    echo "  example:uninstall auth  Remove the generated authentication example\n";
    echo "\n";
    echo "Help:\n";
    echo "  help                    Show this help message\n";
    echo "\n";
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
    echo "\n";
    echo "For more information, visit: https://github.com/Ibnu-Afdel/DALT.PHP\n";
    echo "\n";
    exit(0);
}

// CLI commands share autoloading and path helpers, but database configuration is
// intentionally loaded only by commands that use the database.
boot_core();

$command = $arguments[1];

switch ($command) {
    case 'serve':
        $host = $arguments[2] ?? '127.0.0.1';
        $portArgument = $arguments[3] ?? '8000';
        if (
            preg_match('/\A(?:localhost|(?:[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?))\z/i', $host) !== 1
            && filter_var($host, FILTER_VALIDATE_IP) === false
        ) {
            fwrite(STDERR, "Invalid host. Use a hostname or IP address.\n");
            exit(1);
        }
        if (preg_match('/\A[0-9]+\z/', $portArgument) !== 1) {
            fwrite(STDERR, "Invalid port. Use a number from 1 to 65535.\n");
            exit(1);
        }
        $port = (int) $portArgument;
        if ($port < 1 || $port > 65535) {
            fwrite(STDERR, "Invalid port. Use a number from 1 to 65535.\n");
            exit(1);
        }
        $maxTries = 50;
        $chosenPort = $port;
        $isFree = function(string $h, int $p): bool {
            $conn = @fsockopen($h, $p, $errno, $errstr, 0.2);
            if (is_resource($conn)) { fclose($conn); return false; }
            return true;
        };
        while ($maxTries-- > 0 && !$isFree($host, $chosenPort)) {
            $chosenPort++;
            if ($chosenPort > 65535) {
                break;
            }
        }
        if ($chosenPort > 65535 || !$isFree($host, $chosenPort)) {
            fwrite(STDERR, "No free port found from {$port} through " . min(65535, $port + 50) . ".\n");
            exit(1);
        }
        if ($chosenPort !== $port) {
            echo "Port {$port} in use. Using {$chosenPort} instead.\n";
        }
        $serverHost = filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6) !== false ? "[{$host}]" : $host;
        echo "Starting development server: http://{$serverHost}:{$chosenPort}\n";
        exit(run_foreground([
            PHP_BINARY,
            '-S',
            "{$serverHost}:{$chosenPort}",
            '-t',
            base_path('public'),
            base_path('public/router.php'),
        ], BASE_PATH));

    
    // Ground truth for "where are we?". Every prose status in this repository can go
    // stale, and one did: a fresh session read START_HERE.md and reported that
    // Fullstack implementation had not started when four parts were finished. This
    // reads the catalog, the track manifest and the build specifications on disk, so
    // it is wrong only if the repository is.
    case 'fullstack:status':
        require_platform($command);
        $track = \Core\FullstackTrack::load();
        $lessons = array_column(\Core\CourseLoader::getLessons(), null, 'id');
        $specs = \Core\BuildMilestone::all();

        $bold = "\033[1m";
        $dim = "\033[2m";
        $green = "\033[32m";
        $yellow = "\033[33m";
        $off = "\033[0m";

        echo "\n{$bold}DALT Fullstack — built state, computed from disk{$off}\n";
        echo "{$dim}Authoring process: docs/dalt-fullstack/PIPELINE.md{$off}\n\n";

        $builtLessons = 0;
        $totalLessons = 0;
        $nextPart = null;
        foreach ($track['parts'] as $number => $part) {
            $partNumber = str_pad((string) $number, 2, '0', STR_PAD_LEFT);
            $written = count($part['lessons']);
            $milestones = array_column($part['milestones'], 'id');
            $specced = array_values(array_filter($milestones, static fn (string $id): bool => isset($specs[$id])));
            $totalLessons += $written;
            $builtLessons += $written;

            // Part 12 is deliberately capstone-only: seven Build specifications and
            // no new lessons. A zero-lesson part is therefore not evidence that
            // implementation has not started; its declared milestones are its work.
            $hasDeclaredWork = $written > 0 || $milestones !== [];
            $done = $hasDeclaredWork && count($specced) === count($milestones);
            $mark = $done ? "{$green}✔{$off}" : ($hasDeclaredWork ? "{$yellow}~{$off}" : "{$dim}·{$off}");
            if (!$done && $nextPart === null) {
                $nextPart = $partNumber;
            }

            printf(
                "  %s PART %s  %-38s %s\n",
                $mark,
                $partNumber,
                $part['title'],
                $written === 0 && $milestones === []
                    ? "{$dim}not started{$off}"
                    : sprintf('%d lesson%s · %s', $written, $written === 1 ? '' : 's', $specced === []
                        ? "{$yellow}" . implode(',', $milestones) . " unspecified{$off}"
                        : implode(',', $specced) . ' specified'),
            );
        }

        printf("\n  %d of 34 lessons written (orders 20–%d) · %d build specifications\n", $builtLessons, 19 + $builtLessons, count($specs));

        echo "\n{$bold}Next{$off}\n";
        if ($nextPart === null) {
            echo "  All declared parts are built. Next is the A3 audit and the freeze (PIPELINE.md §5).\n";
        } else {
            $part = $track['parts'][$nextPart];
            echo "  Part {$nextPart} — {$part['title']}\n";
            echo "  {$dim}{$part['purpose']}{$off}\n";
            echo "  Authoritative spec: CURRICULUM.md, the section for Part {$nextPart}.\n";
            echo "  Loop, gate and audit checkpoints: docs/dalt-fullstack/PIPELINE.md.\n";
        }

        // Audit state is read from WORKLOG.md rather than hardcoded. The whole premise
        // of this command is that it computes from disk and cannot go stale; a literal
        // "never run" here would have kept saying that after an audit had been run.
        $worklog = is_file(base_path('docs/dalt-fullstack/WORKLOG.md'))
            ? (string) file_get_contents(base_path('docs/dalt-fullstack/WORKLOG.md'))
            : '';

        echo "\n{$bold}Audits{$off} {$dim}(PIPELINE.md §5){$off}\n";
        foreach ([['A0', 'Parts 00–03', 3], ['A1', 'Parts 04–06', 6], ['A2', 'Parts 07–09', 9], ['A3', 'Parts 10–12', 12]] as [$id, $scope, $after]) {
            $recorded = preg_match(
                '/^##\s+.*\b' . $id . '\b.*?(\d{4}-\d{2}-\d{2})\s*$/m',
                $worklog,
                $match,
            ) === 1;

            if ($recorded) {
                // A section listing open findings is not a clean pass, and saying so is
                // the difference between a record and a rubber stamp.
                $section = substr($worklog, (int) strpos($worklog, $match[0]));
                $next = strpos($section, "\n## ", 1);
                $open = preg_match_all('/—\s*OPEN\s*$/m', $next === false ? $section : substr($section, 0, $next));

                $state = $open > 0
                    ? "{$green}run {$match[1]}{$off} {$yellow}· {$open} open{$off}"
                    : "{$green}passed {$match[1]}{$off}";
            } else {
                $reached = $builtLessons > 0 && $nextPart !== null && (int) $nextPart > $after;
                $state = $reached ? "{$yellow}due{$off}" : "{$dim}pending{$off}";
            }

            printf("  %s  %-14s %s\n", $id, $scope, $state);
        }
        echo "\n";
        exit(0);

    case 'dalt:test':
        require_platform($command);
        $dirs = array_filter(glob(base_path('.dalt/course/challenges/*')), 'is_dir');
        $challenges = array_map('basename', $dirs);
        
        $target = $arguments[2] ?? null;
        if ($target && in_array($target, $challenges)) {
            $challenges = [$target];
        } else if ($target) {
            echo "Challenge '$target' not found.\n";
            exit(1);
        }

        echo "\n=================================================\n";
        echo "             DALT.PHP TEST RUNNER                \n";
        echo "=================================================\n\n";

        require_once base_path('.dalt/Core/ChallengeVerifier.php');

        $totalTests = 0;
        $totalPassed = 0;

        foreach ($challenges as $ch) {
            echo "\033[1;36mChallenge: $ch\033[0m\n";
            $verifier = new \Core\ChallengeVerifier(".dalt/course/challenges/$ch");
            $result = $verifier->verify();
            
            $tests = $result['results'] ?? [];
            $chPassed = $result['passed'] ?? 0;
            $chTotal = $result['total'] ?? 0;
            
            $totalTests += $chTotal;
            $totalPassed += $chPassed;

            foreach ($tests as $name => $test) {
                if ($test['passed']) {
                    echo "  \033[32m✔ {$test['name']}\033[0m\n";
                } else {
                    echo "  \033[31m✘ {$test['name']}\033[0m - {$test['message']}\n";
                }
            }
            if ($chTotal === 0) {
                 echo "  \033[33mNo tests configured or found.\033[0m\n\n";
            } else if ($chPassed === $chTotal) {
                 echo "  \033[1;32mStatus: PASSED ($chPassed/$chTotal)\033[0m\n\n";
            } else {
                 echo "  \033[1;31mStatus: FAILED ($chPassed/$chTotal)\033[0m\n\n";
            }
        }
        
        echo "=================================================\n";
        echo " Total Progress: $totalPassed / $totalTests tests passed.\n";
        echo "=================================================\n\n";
        exit($totalTests > 0 && $totalPassed === $totalTests ? 0 : 1);

    case 'migrate':
        try {
            $dbConfig = load_database_config();
            $database = Core\DatabaseManager::create($dbConfig['database']);
            $migration = new Core\Migration($database);
            $migration->runMigrations();
            echo "Migration process completed.\n";
        } catch (\Throwable $e) {
            echo "\n" . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    case 'migrate:fresh':
        echo "Running migrate:fresh...\n";
        try {
            $dbConfig = load_database_config();
        } catch (\Throwable $e) {
            echo "\n" . $e->getMessage() . "\n";
            exit(1);
        }
        if (!in_array('--force', array_slice($arguments, 2), true)) {
            echo "This command permanently deletes all data in the configured database.\n";
            echo "Continue? [y/N]: ";
            $confirmation = fgets(STDIN);
            if (!is_string($confirmation) || !in_array(strtolower(trim($confirmation)), ['y', 'yes'], true)) {
                echo "Cancelled. No changes made.\n";
                exit(1);
            }
        }
        $driver = $dbConfig['database']['driver'] ?? 'sqlite';
        if ($driver === 'sqlite') {
            $dbPath = $dbConfig['database']['database'];
            if (!is_string($dbPath)) {
                echo "\nSQLite database path must be a string.\n";
                exit(1);
            }
            if (
                $dbPath !== ''
                && $dbPath !== ':memory:'
                && !str_starts_with($dbPath, '/')
                && !str_starts_with($dbPath, '\\')
                && preg_match('/\A[A-Za-z]:[\\\\\/]/', $dbPath) !== 1
            ) {
                $dbPath = base_path($dbPath);
            }
            if ($dbPath !== '' && $dbPath !== ':memory:' && file_exists($dbPath)) {
                if (!is_file($dbPath) || !unlink($dbPath)) {
                    echo "\nUnable to remove SQLite database file.\n";
                    exit(1);
                }
                echo "Dropped existing database file.\n";
            }
        } elseif ($driver === 'pgsql') {
            try {
                $database = new Core\Database($dbConfig['database']);
                $database->getConnection()->exec('DROP SCHEMA public CASCADE; CREATE SCHEMA public;');
                echo "Dropped and recreated public schema.\n";
            } catch (\Throwable $e) {
                echo "\nFailed to reset PostgreSQL schema.\n";
                echo $e->getMessage() . "\n";
                exit(1);
            }
        } else {
            echo "Unsupported database driver: " . (is_scalar($driver) ? (string) $driver : get_debug_type($driver)) . "\n";
            exit(1);
        }
        try {
            $database = Core\DatabaseManager::create($dbConfig['database']);
            $migration = new Core\Migration($database);
            $migration->runMigrations();
            echo "Fresh migration completed.\n";
        } catch (\Throwable $e) {
            echo "\n" . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    case 'make:migration':
        if (!isset($arguments[2])) {
            echo "Usage: php artisan make:migration <name>\n";
            echo "Example: php artisan make:migration create_posts_table\n";
            exit(1);
        }
        
        $name = $arguments[2];
        if (preg_match('/\A[a-z][a-z0-9_]*\z/', $name) !== 1) {
            echo "Migration names must start with a lowercase letter and contain only lowercase letters, numbers, and underscores.\n";
            exit(1);
        }

        // Clean the name: remove 'create_' prefix and '_table' suffix if present
        $cleanName = preg_replace('/^create_/', '', $name);
        $cleanName = preg_replace('/_table$/', '', $cleanName);
        if (!is_string($cleanName) || preg_match('/\A[a-z][a-z0-9_]*\z/', $cleanName) !== 1) {
            echo "Migration name must produce a valid table identifier after removing create_ and _table.\n";
            exit(1);
        }

        try {
            $dbConfig = load_database_config();
        } catch (\Throwable $e) {
            echo $e->getMessage() . "\n";
            exit(1);
        }
        $driver = $dbConfig['database']['driver'] ?? 'sqlite';
        if (!in_array($driver, ['sqlite', 'pgsql'], true)) {
            echo "Unsupported database driver: " . (is_scalar($driver) ? (string) $driver : get_debug_type($driver)) . "\n";
            exit(1);
        }
        
        // Generate filename with timestamp
        $timestamp = date('YmdHis');
        $filename = "{$timestamp}_{$name}.sql";
        $relativeDir = 'database/migrations';
        $filepath = base_path("database/migrations/{$filename}");
        
        $migrationDirectory = base_path('database/migrations');
        if (!is_dir($migrationDirectory) && !mkdir($migrationDirectory, 0755, true) && !is_dir($migrationDirectory)) {
            fwrite(STDERR, "Unable to create migration directory: database/migrations\n");
            exit(1);
        }
        
        // Generate SQL template
        $currentDate = date('Y-m-d H:i:s');
        if ($driver === 'pgsql') {
            $template = <<<SQL
-- Migration: {$name}
-- Created: {$currentDate}

CREATE TABLE IF NOT EXISTS "{$cleanName}" (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Add indexes here
-- CREATE INDEX IF NOT EXISTS idx_{$cleanName}_name ON "{$cleanName}"(name);
SQL;
        } else {
            $template = <<<SQL
-- Migration: {$name}
-- Created: {$currentDate}

CREATE TABLE IF NOT EXISTS "{$cleanName}" (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name VARCHAR(255) NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- Add indexes here
-- CREATE INDEX IF NOT EXISTS idx_{$cleanName}_name ON "{$cleanName}"(name);
SQL;
        }
        
        $migrationFile = @fopen($filepath, 'x');
        if (!is_resource($migrationFile)) {
            echo "Migration already exists or cannot be created: {$relativeDir}/{$filename}\n";
            exit(1);
        }

        try {
            if (fwrite($migrationFile, $template) === false) {
                throw new RuntimeException("Unable to write migration: {$relativeDir}/{$filename}");
            }
        } finally {
            fclose($migrationFile);
        }

        echo "Migration created: {$relativeDir}/{$filename}\n";
        echo "\n";
        echo "Next steps:\n";
        echo "1. Edit the migration file to define your table structure\n";
        echo "2. Run: php artisan migrate\n";
        break;

    case 'example:install':
    case 'example:update':
    case 'example:uninstall':
        require_platform($command);
        $which = $arguments[2] ?? '';
        if ($which !== 'auth') {
            echo "Usage: php artisan {$command} auth" . ($command === 'example:uninstall' ? ' [--force]' : '') . "\n";
            exit(1);
        }
        $extra = array_slice($arguments, 3);
        $force = $command === 'example:uninstall' && $extra === ['--force'];
        if ($extra !== [] && !$force) {
            echo "Usage: php artisan {$command} auth" . ($command === 'example:uninstall' ? ' [--force]' : '') . "\n";
            exit(1);
        }
        try {
            $manager = new Core\AuthScaffoldManager(base_path());
            $message = match ($command) {
                'example:install' => $manager->install(),
                'example:update' => $manager->update(),
                'example:uninstall' => $manager->uninstall($force),
            };
            echo $message . "\n";
        } catch (Core\AuthScaffoldException $exception) {
            fwrite(STDERR, $exception->getMessage() . "\n");
            exit(1);
        }
        break;

    case 'challenge:list':
        require_platform($command);
        require_once base_path('.dalt/Core/ChallengeManager.php');
        $metadata = Core\ChallengeManager::getChallengeMetadata();
        if (empty($metadata)) {
            echo "\nNo challenges found. Make sure .dalt/course/challenges/ exists.\n\n";
            break;
        }
        echo "\n";
        echo "╔══════════════════════════════════════════════════════════════╗\n";
        echo "║                    Available Challenges                      ║\n";
        echo "╚══════════════════════════════════════════════════════════════╝\n\n";
        foreach ($metadata as $m) {
            $status = $m['passed'] ? "\033[32m✓\033[0m" : " ";
            $line = sprintf("  %s %d. %-20s %-8s (%d bug%s)", $status, $m['num'], $m['id'], "[" . $m['difficulty'] . "]", $m['bugs'], $m['bugs'] === 1 ? '' : 's');
            echo $line . "\n";
        }
        echo "\nRun: php artisan challenge:start <name> to begin\n";
        echo "     php artisan challenge:verify when you think you fixed it\n\n";
        break;

    case 'challenge:start':
        require_platform($command);
        $challengeName = $arguments[2] ?? '';
        if (empty($challengeName)) {
            echo "Usage: php artisan challenge:start <challenge-name>\n";
            echo "Example: php artisan challenge:start broken-routing\n";
            echo "\nRun php artisan challenge:list to see available challenges.\n";
            exit(1);
        }
        require_once base_path('.dalt/Core/ChallengeManager.php');
        if (Core\CourseLoader::getChallenge($challengeName) === null) {
            echo "Error: Challenge '{$challengeName}' not found.\n";
            echo "Run php artisan challenge:list to see available challenges.\n";
            exit(1);
        }
        // Starting always replaces tracked skeleton files, so the prompt is
        // unconditional. fgets() returns false at EOF, which a non-interactive
        // caller always hits; treat that as a decline rather than a fatal.
        if (!in_array('--force', array_slice($arguments, 3), true)) {
            echo "\n⚠️  This will overwrite files in framework/, routes/, app/Http/controllers/.\n";
            echo "Continue? [y/N]: ";
            $confirmation = fgets(STDIN);
            if (!is_string($confirmation) || !in_array(strtolower(trim($confirmation)), ['y', 'yes'], true)) {
                echo "Aborted.\n";
                exit(0);
            }
        }
        try {
            $started = Core\ChallengeManager::start($challengeName);
        } catch (Core\ChallengeStateException $exception) {
            fwrite(STDERR, "Error: {$exception->getMessage()}\n");
            exit(1);
        }
        if (!$started) {
            echo "Error: Challenge '{$challengeName}' not found.\n";
            exit(1);
        }
        echo "\n🎯 Challenge '{$challengeName}' loaded!\n\n";
        echo "Your app now has intentionally broken code. Fix the bugs in your IDE.\n\n";
        if (in_array($challengeName, ['broken-auth'], true)) {
            echo "Tip: Run \033[1mphp artisan migrate\033[0m if you haven't already (creates users table).\n\n";
        }
        echo "When ready, run: \033[1mphp artisan challenge:verify\033[0m\n";
        echo "Stuck? Run: \033[1mphp artisan challenge:reset\033[0m for a fresh start.\n\n";
        break;

    case 'challenge:reset':
        require_platform($command);
        require_once base_path('.dalt/Core/ChallengeManager.php');
        $active = Core\ChallengeManager::getActiveChallenge();
        if ($active === null) {
            echo "\nNo active challenge. Run php artisan challenge:start <name> first.\n\n";
            exit(0);
        }
        try {
            Core\ChallengeManager::reset();
        } catch (Core\ChallengeStateException $exception) {
            fwrite(STDERR, "Error: {$exception->getMessage()}\n");
            exit(1);
        }
        echo "\n🔄 Challenge '{$active}' reset to buggy baseline. Ready for another try!\n\n";
        break;

    case 'challenge:stop':
        require_platform($command);
        require_once base_path('.dalt/Core/ChallengeManager.php');
        $active = Core\ChallengeManager::getActiveChallenge();
        if ($active === null) {
            echo "\nNo active challenge. Nothing to stop.\n\n";
            exit(0);
        }
        try {
            Core\ChallengeManager::stop();
        } catch (Core\ChallengeStateException $exception) {
            fwrite(STDERR, "Error: {$exception->getMessage()}\n");
            exit(1);
        }
        echo "\n✅ Challenge stopped. App restored to clean state.\n\n";
        break;

    case 'challenge:verify':
        require_platform($command);
        require_once base_path('.dalt/Core/ChallengeManager.php');
        require_once base_path('.dalt/Core/ChallengeVerifier.php');
        $active = Core\ChallengeManager::getActiveChallenge();
        if ($active === null) {
            echo "\nNo active challenge. Run: php artisan challenge:start <name>\n";
            echo "Then fix the bugs and run this again.\n\n";
            exit(1);
        }
        $challengePath = ".dalt/course/challenges/{$active}";
        $verifier = new Core\ChallengeVerifier($challengePath, true);
        $result = $verifier->verify();

        echo "\n";
        echo "╔══════════════════════════════════════════════════════════════╗\n";
        echo "║           DALT Challenge Verification System                ║\n";
        echo "╚══════════════════════════════════════════════════════════════╝\n";
        echo "\nVerifying: {$active}\n";
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n";

        foreach ($result['results'] as $test) {
            $icon = $test['passed'] ? '✓' : '✗';
            $color = $test['passed'] ? "\033[32m" : "\033[31m";
            $reset = "\033[0m";
            echo "{$color}{$icon}{$reset} [{$test['name']}] {$test['message']}\n";
            if (!$test['passed'] && !empty($test['hint'])) {
                echo "  💡 Hint: {$test['hint']}\n";
            }
        }

        echo "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
        echo "Results: {$result['passed']}/{$result['total']} tests passed\n";
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n";

        if ($result['status'] === 'pass') {
            Core\ChallengeManager::markPassed($active);
            echo "🎉 {$result['message']}\n\n";
            echo "Great job! You've successfully fixed this challenge.\n";
            echo "Run php artisan challenge:list to pick the next one.\n\n";
        } elseif ($result['status'] === 'error') {
            fwrite(STDERR, "Verification error: {$result['message']}\n");
        } else {
            echo "❌ {$result['message']}\n\n";
            if (!empty($result['hint'])) {
                echo "💡 Next step: {$result['hint']}\n\n";
            }
            echo "Keep debugging! Run php artisan challenge:reset for a fresh start.\n\n";
        }

        Core\ChallengeVerifier::logResult($active, $result);
        exit($result['status'] === 'pass' ? 0 : 1);

    case 'verify':
        require_platform($command);
        $challengeName = $arguments[2] ?? '';
        if (empty($challengeName)) {
            echo "Usage: php artisan verify <challenge-name>\n";
            echo "Example: php artisan verify broken-routing\n";
            echo "\nPreferred: php artisan challenge:start <name> then challenge:verify\n";
            echo "Available: broken-routing, broken-middleware, broken-auth, broken-database, broken-session\n";
            exit(1);
        }

        $challengePath = ".dalt/course/challenges/{$challengeName}";
        
        if (!is_dir(base_path($challengePath))) {
            echo "Error: Challenge '{$challengeName}' not found.\n";
            echo "Make sure the challenge exists in .dalt/course/challenges/ directory.\n";
            exit(1);
        }

        $active = Core\ChallengeManager::getActiveChallenge();
        if ($active !== $challengeName) {
            echo "Error: Challenge '{$challengeName}' is not active.\n";
            echo "Run: php artisan challenge:start {$challengeName}\n";
            exit(1);
        }

        echo "\n";
        echo "╔══════════════════════════════════════════════════════════════╗\n";
        echo "║           DALT Challenge Verification System                ║\n";
        echo "╚══════════════════════════════════════════════════════════════╝\n";
        echo "\n";
        echo "Verifying: {$challengeName}\n";
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n";

        $verifier = new Core\ChallengeVerifier($challengePath, true);
        $result = $verifier->verify();

        // Display results
        foreach ($result['results'] as $test) {
            $icon = $test['passed'] ? '✓' : '✗';
            $color = $test['passed'] ? "\033[32m" : "\033[31m";
            $reset = "\033[0m";
            
            echo "{$color}{$icon}{$reset} {$test['message']}\n";
            
            if (!$test['passed'] && !empty($test['hint'])) {
                echo "  💡 Hint: {$test['hint']}\n";
            }
        }

        echo "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
        echo "Results: {$result['passed']}/{$result['total']} tests passed\n";
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n";

        if ($result['status'] === 'pass') {
            echo "🎉 {$result['message']}\n\n";
            echo "Great job! You've successfully fixed this challenge.\n";
            echo "Check storage/logs/challenges.log for your progress.\n";
        } elseif ($result['status'] === 'error') {
            fwrite(STDERR, "Verification error: {$result['message']}\n");
        } else {
            echo "❌ {$result['message']}\n\n";
            if (!empty($result['hint'])) {
                echo "💡 Next step: {$result['hint']}\n\n";
            }
            echo "Keep debugging! Check the challenge README for more hints.\n";
        }

        echo "\n";

        // Log result
        Core\ChallengeVerifier::logResult($challengeName, $result);
        
        exit($result['status'] === 'pass' ? 0 : 1);

    case 'dev':
        require_platform($command);
        echo "Starting DALT.PHP development environment...\n";
        echo "\n";
        echo "This will start:\n";
        echo "  1. PHP development server (port 8000)\n";
        echo "  2. Vite dev server (port 5173)\n";
        echo "\n";
        echo "Press Ctrl+C to stop both servers.\n";
        echo "\n";
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n";
        
        $npm = PHP_OS_FAMILY === 'Windows' ? 'npm.cmd' : 'npm';
        $npmCheck = proc_open([$npm, '--version'], [['file', PHP_OS_FAMILY === 'Windows' ? 'NUL' : '/dev/null', 'r'], ['file', PHP_OS_FAMILY === 'Windows' ? 'NUL' : '/dev/null', 'w'], ['file', PHP_OS_FAMILY === 'Windows' ? 'NUL' : '/dev/null', 'w']], $npmPipes, BASE_PATH, null, ['bypass_shell' => true]);
        if (!is_resource($npmCheck) || proc_close($npmCheck) !== 0) {
            fwrite(STDERR, "npm is required for the dev command. Install Node.js and try again.\n");
            exit(1);
        }

        $descriptors = [STDIN, STDOUT, STDERR];
        $viteServer = proc_open([$npm, 'run', 'dev'], $descriptors, $vitePipes, BASE_PATH, null, ['bypass_shell' => true]);
        if (!is_resource($viteServer)) {
            fwrite(STDERR, "Unable to start the Vite development server.\n");
            exit(1);
        }
        usleep(100_000);
        $viteStatus = proc_get_status($viteServer);
        if (!$viteStatus['running']) {
            proc_close($viteServer);
            exit($viteStatus['exitcode'] < 0 ? 1 : $viteStatus['exitcode']);
        }

        $phpServer = proc_open([PHP_BINARY, base_path('artisan'), 'serve'], $descriptors, $phpPipes, BASE_PATH, null, ['bypass_shell' => true]);
        if (!is_resource($phpServer)) {
            proc_terminate($viteServer);
            proc_close($viteServer);
            fwrite(STDERR, "Unable to start the PHP development server.\n");
            exit(1);
        }

        $exitCode = 0;
        while (true) {
            $phpStatus = proc_get_status($phpServer);
            $viteStatus = proc_get_status($viteServer);
            if (!$phpStatus['running'] || !$viteStatus['running']) {
                $exitCode = !$phpStatus['running'] ? $phpStatus['exitcode'] : $viteStatus['exitcode'];
                break;
            }
            usleep(100_000);
        }
        if ($phpStatus['running']) {
            proc_terminate($phpServer);
        }
        if ($viteStatus['running']) {
            proc_terminate($viteServer);
        }
        proc_close($phpServer);
        proc_close($viteServer);
        exit($exitCode < 0 ? 1 : $exitCode);

    case 'test':
        echo "Running Pest test suite...\n";
        echo "\n";
        
        if (!file_exists(base_path('vendor/bin/pest'))) {
            echo "⚠️  Pest is not installed.\n";
            echo "\n";
            echo "Install Pest by running:\n";
            echo "  composer require pestphp/pest --dev\n";
            echo "\n";
            exit(1);
        }
        
        exit(run_foreground(array_merge([PHP_BINARY, base_path('vendor/bin/pest')], array_slice($arguments, 2)), BASE_PATH));

    case 'platform:status':
        echo "\n";
        if (platform_installed()) {
            echo "Guided learning: installed (.dalt found)\n";
            echo "Lessons, challenges, and related artisan commands are available.\n";
        } else {
            echo "Framework core only: guided learning not installed (.dalt not found)\n";
            echo "Lessons, challenges, and guided-learning artisan commands are disabled.\n";
        }
        echo "\n";
        break;

    case 'platform:clean':
    case 'platform:remove':
        $platformArguments = array_slice($arguments, 2);
        $force = $platformArguments === ['--force'];
        if ($platformArguments !== [] && !$force) {
            echo "Usage: php artisan {$command} [--force]\n";
            exit(1);
        }
        if (is_link(base_path('.dalt'))) {
            fwrite(STDERR, "Refusing to remove an unsafe symbolic-link .dalt path.\n");
            exit(1);
        }
        if (!is_dir(base_path('.dalt'))) {
            echo "\n✓ Guided learning layer already removed.\n";
            echo "DALT.PHP is running as the framework core only.\n\n";
            exit(0);
        }
        
        echo "\n";
        echo "╔════════════════════════════════════════════════════════════╗\n";
        echo "║         Remove guided learning (.dalt)                     ║\n";
        echo "╚════════════════════════════════════════════════════════════╝\n";
        echo "\n";
        echo "This will permanently remove the guided learning layer and leave\n";
        echo "DALT.PHP as the framework core only.\n";
        echo "\n";
        echo "Application files, including an installed auth example, will be kept.\n";
        echo "\n";

        if (!$force) {
            echo "Do you want to continue? [y/N]: ";
            $line = trim((string) fgets(STDIN));

            if (strtolower($line) !== 'y' && strtolower($line) !== 'yes') {
                echo "\nCancelled. No changes made.\n\n";
                exit(1);
            }
        }
        
        if (file_exists(base_path('.dalt/scripts/cleanup.php'))) {
            require base_path('.dalt/scripts/cleanup.php');
        } else {
            echo "\nError: Cleanup script not found.\n";
            echo "Please manually remove .dalt/ directory.\n\n";
            exit(1);
        }
        break;

    case 'help':
    case '--help':
    case '-h':
        // Help is handled at the top, but include here for completeness
        passthru("php artisan");
        break;

    default:
        echo "Unknown command: $command\n";
        echo "Run 'php artisan help' to see available commands.\n";
        exit(1);
}
