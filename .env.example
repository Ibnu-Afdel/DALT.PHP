# Application Settings
APP_NAME="DALT.PHP"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120
# SESSION_NAME=daltphp_custom
# SESSION_PATH=/
# SESSION_DOMAIN=
# SESSION_SECURE_COOKIE=(null)
SESSION_SAME_SITE=Lax

# Database Configuration
# DALT supports three drivers: sqlite, pgsql, and mysql. Any other value is rejected
# at connection time with "Unsupported database driver".

# SQLite (default) - the simplest option for getting started
DB_DRIVER=sqlite
DB_DATABASE=database/app.sqlite

# PostgreSQL (uncomment to use; requires the pdo_pgsql extension)
# DB_DRIVER=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=dalt_php_app
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_CHARSET=utf8

# MySQL 8.0+ (uncomment to use; requires the pdo_mysql extension)
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=dalt_php_app
# DB_USERNAME=root
# DB_PASSWORD=your_password
# DB_CHARSET=utf8mb4
